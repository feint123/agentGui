{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Quality Smoke",
			"type": "shell",
			"command": "./scripts/run_quality_smoke.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Sample UI Baseline",
			"type": "shell",
			"command": "./scripts/sample_quality_baseline.sh ui 5",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"problemMatcher": []
		},
