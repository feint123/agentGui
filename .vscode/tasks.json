			"label": "Focused ACP Tests",
			"type": "shell",
			"command": "xcodebuild",
			"args": [
				"test",
				"-parallel-testing-enabled",
				"NO",
				"-project",
				"agentGui.xcodeproj",
				"-scheme",
				"agentGui",
				"-destination",
				"platform=macOS",
				"-only-testing:agentGuiTests/ACPSessionConfigurationPresentationTests",
				"-only-testing:agentGuiTests/ACPExternalExecutionProviderBaseTests",
				"-only-testing:agentGuiTests/DynamicACPExternalExecutionProviderTests",
				"CODE_SIGNING_ALLOWED=NO"
